APP_ENV=dev
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
ADMIN_TOKEN=promijeni-ovo-jaki-token
# AI jezgro: isključivo OpenCode CLI (besplatni modeli). NEMA API ključeva ni fallbacka.
# Prijava jednom na serveru: `opencode auth login`. Modeli: `opencode models`.
OPENCODE_BIN=opencode
OPENCODE_MODEL=
OPENCODE_TIMEOUT=45
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=60
AI_RATE_LIMIT_PER_MIN=10