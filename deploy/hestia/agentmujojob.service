[Unit]
Description=AgentMujoJob backend API
After=network.target
[Service]
Type=simple
User=sha
WorkingDirectory=/home/sha/AgentMujoJob/backend
EnvironmentFile=/home/sha/AgentMujoJob/backend/.env
ExecStart=/home/sha/AgentMujoJob/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5
StartLimitBurst=5
[Install]
WantedBy=multi-user.target
