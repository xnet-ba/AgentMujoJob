APP_ENV=dev
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
ADMIN_TOKEN=promijeni-ovo-jaki-token
# AI jezgro: isključivo OpenCode CLI (besplatni modeli). NEMA API ključeva ni fallbacka.
# `opencode/*-free` modeli rade bez prijave/računa. Lista: `opencode models`.
OPENCODE_BIN=opencode
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
OPENCODE_TIMEOUT=45
CORS_ORIGINS=http://tauri.localhost,tauri://localhost
RATE_LIMIT_PER_MIN=60
AI_RATE_LIMIT_PER_MIN=10