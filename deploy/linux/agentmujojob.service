[Unit]
Description=AgentMujoJob backend API
After=network.target
[Service]
Type=simple
User=agentmujojob
WorkingDirectory=/opt/agentmujojob/backend
EnvironmentFile=/opt/agentmujojob/backend/.env
ExecStart=/opt/agentmujojob/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5
StartLimitBurst=5
[Install]
WantedBy=multi-user.target
